# Modelo do agente. Sem esta variavel o agente usa o planner deterministico local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Endpoints usados pelo scraper (Axios + Cheerio).
POE2_WIKI_MODIFIER_BASE_URL=https://www.poe2wiki.net
POE2_TRADE_SEARCH_URL=https://www.pathofexile.com/api/trade2/search/poe2
POE2_LEAGUE=Standard

# Cache do scraper
POE2_CACHE_DIR=.cache
POE2_CACHE_TTL_MINUTES=720

# Feedback / bug reports.
# POE2_FEEDBACK_WEBHOOK_URL=https://seu-servico.example/webhook
# POE2_ISSUES_REPO=usuario/repositorio